{
  "redirects": [
    { "source": "/overview",      "destination": "/",              "permanent": false },
    { "source": "/learn",         "destination": "/learning-path", "permanent": false },
    { "source": "/labs",          "has": [{ "type": "host", "value": "swayform.net" }], "destination": "https://learning.swayform.net/labs", "permanent": false },
    { "source": "/labs",          "has": [{ "type": "host", "value": "www.swayform.net" }], "destination": "https://learning.swayform.net/labs", "permanent": false },
    { "source": "/curriculum",    "destination": "/learning-path", "permanent": false },
    { "source": "/platform",      "destination": "/robot",         "permanent": false },
    { "source": "/robots",        "destination": "/robot",         "permanent": false },
    { "source": "/schools",       "destination": "/for-schools",   "permanent": false },
    { "source": "/demos",         "has": [{ "type": "host", "value": "swayform.net" }], "destination": "https://learning.swayform.net/demos", "permanent": false },
    { "source": "/demos",         "has": [{ "type": "host", "value": "www.swayform.net" }], "destination": "https://learning.swayform.net/demos", "permanent": false },
    { "source": "/demo-programs", "has": [{ "type": "host", "value": "swayform.net" }], "destination": "https://learning.swayform.net/demos", "permanent": false },
    { "source": "/demo-programs", "has": [{ "type": "host", "value": "www.swayform.net" }], "destination": "https://learning.swayform.net/demos", "permanent": false },

    { "source": "/learning-hub", "has": [{ "type": "host", "value": "swayform.net" }], "destination": "https://learning.swayform.net/", "permanent": true },
    { "source": "/learning-hub", "has": [{ "type": "host", "value": "www.swayform.net" }], "destination": "https://learning.swayform.net/", "permanent": true },
    { "source": "/learning-hub/:path*", "has": [{ "type": "host", "value": "swayform.net" }], "destination": "https://learning.swayform.net/:path*", "permanent": true },
    { "source": "/learning-hub/:path*", "has": [{ "type": "host", "value": "www.swayform.net" }], "destination": "https://learning.swayform.net/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/",                         "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub.html" },
    { "source": "/sitemap.xml",              "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub-sitemap.xml" },
    { "source": "/robots.txt",               "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub-robots.txt" },
    { "source": "/",                         "destination": "/home.html" },
    { "source": "/sitemap.xml",              "destination": "/main-sitemap.xml" },
    { "source": "/robots.txt",               "destination": "/main-robots.txt" },
    { "source": "/getting-started",          "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/getting-started.html" },
    { "source": "/classroom-workflow",       "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/classroom-workflow.html" },
    { "source": "/safety",                   "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/safety.html" },
    { "source": "/setup",                    "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/setup.html" },
    { "source": "/ssh",                      "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/ssh.html" },
    { "source": "/projects",                 "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/projects.html" },
    { "source": "/queue",                    "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/queue.html" },
    { "source": "/demos",                    "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/demos.html" },
    { "source": "/demos/wave",                "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/demos/wave.html" },
    { "source": "/demos/handshake",           "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/demos/handshake.html" },
    { "source": "/demos/pick-and-place",      "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/demos/pick-and-place.html" },
    { "source": "/demos/rock-paper-scissors", "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/demos/rock-paper-scissors.html" },
    { "source": "/demos/interactive-exchange","has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/demos/interactive-exchange.html" },
    { "source": "/labs",                     "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/labs.html" },
    { "source": "/repair",                   "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/repair.html" },
    { "source": "/technical-reference",      "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/technical-reference.html" },
    { "source": "/troubleshooting",          "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/troubleshooting.html" },
    { "source": "/glossary",                 "has": [{ "type": "host", "value": "learning.swayform.net" }], "destination": "/learning-hub/glossary.html" },

    { "source": "/purpose",       "destination": "/purpose.html"       },
    { "source": "/robot",         "destination": "/robot.html"         },
    { "source": "/learning-path", "destination": "/learning-path.html" },
    { "source": "/contact",       "destination": "/contact.html"       },
    { "source": "/safety",        "destination": "/safety.html"        },
    { "source": "/for-schools",   "destination": "/for-schools.html"   },
    { "source": "/privacy",       "destination": "/privacy.html"       },
    { "source": "/terms",         "destination": "/terms.html"         },
    { "source": "/accessibility", "destination": "/accessibility.html" },
    { "source": "/robot-safety",  "destination": "/robot-safety.html"  }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
